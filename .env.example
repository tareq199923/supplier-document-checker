# Copy this file to .env and fill in ONE provider. Never commit .env.

# Which provider to use: anthropic | openai | gemini | mock
LLM_PROVIDER=anthropic

# Model name for that provider. Check the provider docs for current names.
LLM_MODEL=

# Seconds to wait for one LLM call before giving up
LLM_TIMEOUT_SECONDS=60

# API keys (only the one you use is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: any OpenAI-compatible server (OpenRouter, Ollama, LM Studio).
# Use with LLM_PROVIDER=openai
OPENAI_BASE_URL=
